      "description": "Действия: scout {handle,limit?}; digest {limit?}; plan {style_id,source_images?,source_text?,mode:mirror|remix|adapt|original,language:ru|es|en|orig,handle?,source_url?}; revise_plan {carousel_id,instruction}; draw {carousel_id,slide_id?} -> фоновая задача {task_id,status,total,ready:false}; status {task_id?,carousel_id?} -> прогресс; pause {task_id}; pack {carousel_id} -> {ready,slides:[{position,url}],caption,link}, только утверждённые финальные PNG; watch_now {author_id?,run_id?} -> {runId,remaining,done}; reel {url}; scenario {transcript,topic?,codeword?}; reread_reference {carousel_id}; restyle {carousel_id,style_id,mode}; save_style {carousel_id,name?}. Ошибки возвращаются в error. draw не является проверкой статуса."
