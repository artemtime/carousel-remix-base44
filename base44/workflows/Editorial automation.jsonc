{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Bounded editorial work and publication reconciliation. No paid work until configured.",
  "name": "Editorial automation",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "editorial_automation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tick_01": {
          "call": "invoke_server_route",
          "with": {
            "path": "/api/editorial/tick",
            "method": "POST"
          },
          "then": "check_01"
        }
      },
      {
        "check_01": {
          "switch": [
            {
              "when": "${ .tick_01.more != true }",
              "then": "end"
            },
            {
              "when": "${ true }",
              "then": "wait_01"
            }
          ]
        }
      },
      {
        "wait_01": {
          "wait": "PT5S",
          "then": "tick_02"
        }
