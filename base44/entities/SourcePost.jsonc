{
  "name": "SourcePost",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string"
    },
    "post_url": {
      "type": "string"
    },
    "shortcode": {
      "type": "string"
    },
    "post_type": {
      "type": "string",
      "enum": [
        "carousel",
        "reel",
        "image"
      ]
    },
    "likes": {
      "type": "number"
    },
    "comments": {
      "type": "number"
    },
    "baseline": {
      "type": "number"
    },
    "ratio": {
      "type": "number"
    },
    "badge": {
      "type": "string",
      "enum": [
        "hot",
        "best",
        "rising"
      ]
    },
    "thumb_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "slide_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caption_text": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "hook": {
      "type": "string"
    },
    "why_viral": {
      "type": "string"
    },
    "seen": {
      "type": "boolean",
      "default": false
    },
    "discovered_at": {
      "type": "string"
    },
    "editorial_item_id": {
      "type": "string"
    },
    "editorial_claim": {
      "type": "string"
    },
    "editorial_claim_until": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}