{
  "name": "Slide",
  "type": "object",
  "properties": {
    "carousel_id": {
      "type": "string"
    },
    "position": {
      "type": "number"
    },
    "role": {
      "type": "string",
      "enum": [
        "hook",
        "body",
        "cta"
      ],
      "default": "body"
    },
    "scene": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "layout": {
      "type": "number",
      "default": 1
    },
    "image_url": {
      "type": "string"
    },
    "image_url_2": {
      "type": "string"
    },
    "critic_status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "failed"
      ],
      "default": "pending"
    },
    "critic_note": {
      "type": "string"
    },
    "panel_checks": {
      "type": "array",
      "description": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u043a\u0430\u0434\u0440\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e: \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u044c \u0433\u0435\u0440\u043e\u044f, \u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u044f \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0441\u0446\u0435\u043d\u0435",
      "items": {
        "type": "object",
        "properties": {
          "panel": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ok",
              "failed"
            ]
          },
          "note": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "drawn",
        "failed"
      ],
      "default": "planned"
    },
    "reference_index": {
      "type": "number"
    },
    "reference_url": {
      "type": "string"
    },
    "reference_brief": {
      "type": "string"
    },
    "reference_card": {
      "type": "object",
      "description": "\u041f\u043e\u043a\u0430\u0440\u0442\u043e\u0447\u043d\u044b\u0439 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b: \u043d\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043c\u044b\u0435 \u043a\u0430\u0434\u0440\u044b, \u0438\u0445 \u0433\u0440\u0430\u043d\u0438\u0446\u044b, \u0434\u043e\u0441\u043b\u043e\u0432\u043d\u044b\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u0438 \u0438 \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u043a\u0438"
    },
    "image_stale": {
      "type": "boolean",
      "default": false
    },
    "previous_images": {
      "type": "object"
    },
    "art_key": {
      "type": "string"
    },
    "render_token": {
      "type": "string"
    },
    "final_image_url": {
      "type": "string"
    },
    "final_render_key": {
      "type": "string"
    },
    "final_check_note": {
      "type": "string"
    },
    "final_check_fix": {
      "type": "string"
    },
    "final_checked_at": {
      "type": "string"
    },
    "final_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "failed"
      ]
    },
    "final_check_result": {
      "type": "object"
    },
    "image_generations": {
      "type": "object",
      "description": "\u041f\u043e \u043d\u043e\u043c\u0435\u0440\u0443 \u043a\u0430\u0434\u0440\u0430: \u0437\u0430\u043f\u0440\u043e\u0448\u0435\u043d\u043d\u0430\u044f \u0438 \u0441\u043e\u043e\u0431\u0449\u0451\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c, \u043f\u0440\u043e\u043f\u043e\u0440\u0446\u0438\u0438, \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0438 URL \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0433\u043e \u0440\u0438\u0441\u0443\u043d\u043a\u0430."
    },
    "final_renderer": {
      "type": "string"
    }
  },
  "required": [
    "carousel_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}