    },
    "scheduled_at": {
      "type": "string"
    },
    "buffer_channel_id": {
      "type": "string"
    },
    "buffer_organization_id": {
      "type": "string"
    },
    "buffer_submitted_at": {
      "type": "string"
    },
    "policy_signature": {
      "type": "string"
    },
    "finalization_token": {
      "type": "string"
    },
    "finalization_until": {
      "type": "string"
    },
    "final_ready": {
      "type": "boolean"
    },
    "buffer_payload": {
      "type": "object"
    }
  },
  "required": [
