{
  "name": "Carousel",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "style_id": {
      "type": "string"
    },
    "style_name": {
      "type": "string"
    },
    "hero_id": {
      "type": "string",
      "description": "\u0413\u0435\u0440\u043e\u0439 \u044d\u0442\u043e\u0439 \u043a\u0430\u0440\u0443\u0441\u0435\u043b\u0438 \u0438\u0437 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438: \u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0431\u0435\u0437 \u0441\u043c\u0435\u043d\u044b \u0441\u0442\u0438\u043b\u044f"
    },
    "hero_name": {
      "type": "string"
    },
    "series": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0442\u0435\u043c\u044b, \u0435\u0441\u043b\u0438 \u043a\u0430\u0440\u0443\u0441\u0435\u043b\u044c \u0441\u043e\u0437\u0434\u0430\u043d\u0430 \u0432 \u0441\u0435\u0440\u0438\u0438 \u043d\u0430 \u043d\u0435\u0434\u0435\u043b\u044e"
    },
    "series_index": {
      "type": "number"
    },
    "series_total": {
      "type": "number"
    },
    "source_post_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_handle": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "orig",
        "ru",
        "es",
        "en"
      ],
      "default": "ru",
      "description": "\u042f\u0437\u044b\u043a \u043d\u0430\u0434\u043f\u0438\u0441\u0435\u0439 \u043d\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430\u0445 \u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u0438. orig \u2014 \u043a\u0430\u043a \u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b\u0435 (\u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u0440\u0435\u0436\u0438\u043c\u0435 \u00ab\u0417\u0435\u0440\u043a\u0430\u043b\u043e\u00bb)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "mirror",
        "remix",
        "adapt",
        "original"
      ],
      "default": "remix"
    },
    "status": {
      "type": "string",
      "enum": [
        "plan",
        "rendering",
        "ready",
        "published",
        "review",
        "paused",
        "queued",
        "scheduled"
      ],
      "default": "plan"
    },
    "caption": {
      "type": "string"
    },
    "price_note": {
      "type": "string"
    },
    "slides_count": {
      "type": "number"
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_profile": {
      "type": "object"
    },
    "active_task_id": {
      "type": "string"
    },
    "enqueue_token": {
      "type": "string"
    },
    "enqueue_until": {
      "type": "string"
    },
    "approved_key": {
      "type": "string"
    },
    "approved_caption": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "image_requests": {
      "type": "number"
    },
    "ai_requests": {
      "type": "number"
    },
    "image_request_limit": {
      "type": "number"
    },
    "publish_token": {
      "type": "string"
    },
    "publish_state": {
      "type": "string"
    },
    "published_key": {
      "type": "string"
    },
    "buffer_post_id": {
      "type": "string"
    },
    "image_model": {
      "type": "string",
      "enum": [
        "automatic",
        "nano_banana_2_1",
        "gpt_image_2"
      ],
      "description": "\u0412\u044b\u0431\u0440\u0430\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0434\u043b\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0445 \u0440\u0438\u0441\u0443\u043d\u043a\u043e\u0432; \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0441\u043d\u0438\u043c\u043e\u043a \u0432\u044b\u0431\u043e\u0440\u0430."
    },
    "is_probe": {
      "type": "boolean"
    },
    "editorial_item_id": {
      "type": "string"
    },
    "policy_revision": {
      "type": "number"
    },
    "repair_key": {
      "type": "string"
    },
    "repair_attempts": {
      "type": "number"
    },
    "repair_token": {
      "type": "string"
    },
    "repair_until": {
      "type": "string"
    },
    "needs_finalization": {
      "type": "boolean"
    },
    "finalization_error": {
      "type": "string"
    },
    "approval_kind": {
      "type": "string"
    },
    "delivery_status": {
      "type": "string"
    },
    "delivery_note": {
